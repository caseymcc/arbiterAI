# cmake -P script, run at build time by webDashboard.cmake: embeds the
# dashboard's built files in arbiterAI-server.
#
#   -DASSET_DIR=<dir>   the installed assets (shell.html, app.js, app.wasm, app.data)
#   -DOUT_DIR=<dir>     where dashboardAssetData.{S,cpp} and the .gz copies go
#
# Each asset is embedded raw and gzipped (gzip -9 -n: no name or time, so the
# bytes depend on the content only) with .incbin, not a brace initializer, and
# gets an ETag from the SHA-256 of its raw bytes.

set(ASSETS shell.html app.js app.wasm app.data)
# a map, not "name|type" list entries: the HTML type has a ";", a list separator
set(MIME_shell.html "text/html; charset=utf-8")
set(MIME_app.js "application/javascript")
set(MIME_app.wasm "application/wasm")
set(MIME_app.data "application/octet-stream")

find_program(GZIP_EXECUTABLE gzip REQUIRED)
file(MAKE_DIRECTORY "${OUT_DIR}")

set(asm "    .section .note.GNU-stack,\"\",@progbits\n    .section .rodata\n")
set(decls "")
set(entries "")
set(index 0)
foreach(name ${ASSETS})
    set(mime "${MIME_${name}}")
    set(raw "${ASSET_DIR}/${name}")
    set(gz "${OUT_DIR}/${name}.gz")
    if(NOT EXISTS "${raw}")
        message(FATAL_ERROR "embedDashboardAssets: ${raw} is missing")
    endif()

    execute_process(
        COMMAND "${GZIP_EXECUTABLE}" -9 -n -c "${raw}"
        OUTPUT_FILE "${gz}"
        RESULT_VARIABLE gzipResult)
    if(NOT gzipResult EQUAL 0)
        message(FATAL_ERROR "embedDashboardAssets: gzip of ${raw} failed (${gzipResult})")
    endif()

    file(SIZE "${raw}" rawSize)
    file(SIZE "${gz}" gzSize)
    file(SHA256 "${raw}" sha)
    string(SUBSTRING "${sha}" 0 32 etag)

    foreach(kind raw gz)
        set(symbol "arbiterai_dashboard_asset_${index}_${kind}")
        string(APPEND asm "    .global ${symbol}\n    .balign 16\n${symbol}:\n    .incbin \"${${kind}}\"\n")
        string(APPEND decls "extern \"C\" const unsigned char ${symbol}[];\n")
    endforeach()
    string(APPEND entries
        "    {\"${name}\", \"${mime}\", arbiterai_dashboard_asset_${index}_raw, ${rawSize}u, "
        "arbiterai_dashboard_asset_${index}_gz, ${gzSize}u, \"\\\"${etag}\\\"\"},\n")
    math(EXPR index "${index}+1")
endforeach()

file(WRITE "${OUT_DIR}/dashboardAssetData.S" "${asm}")
file(WRITE "${OUT_DIR}/dashboardAssetData.cpp"
"// generated by cmake/embedDashboardAssets.cmake
#include \"dashboardAssetTable.h\"

${decls}
namespace arbiterAI
{
namespace server
{

static const DashboardAsset assets[]={
${entries}};

const DashboardAsset *dashboardAssets(size_t &count)
{
    count=sizeof(assets)/sizeof(assets[0]);
    return assets;
}

} // namespace server
} // namespace arbiterAI
")
