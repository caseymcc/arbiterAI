{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arbiterAI/schemas/model-config/v1.1.0",
  "title": "ArbiterAI Model Configuration",
  "description": "Schema for model configuration files",
  "type": "object",
  "required": ["schema_version", "models"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of this configuration schema",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "examples": ["1.0.0", "1.1.0"]
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model", "provider"],
        "properties": {
          "model": {
            "type": "string",
            "description": "Unique model identifier"
          },
          "version": {
            "type": "string",
            "description": "Model version",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "provider": {
            "type": "string",
            "description": "Model provider/service",
            "enum": ["anthropic", "llama", "openai", "deepseek", "openrouter", "mock", "whisper", "stable-diffusion", "vibevoice", "orpheus", "sherpa-onnx", "onnx-genai"]
          },
          "ranking": {
            "type": "integer",
            "description": "Preference order (higher is better)",
            "minimum": 0,
            "maximum": 100,
            "default": 50
          },
          "mode": {
            "type": "string",
            "description": "Model modality. Routes requests to the matching endpoint/method: chat completions, embeddings, speech-to-text (transcription), text-to-speech (speech), or image generation (image).",
            "enum": ["chat", "embedding", "transcription", "speech", "image"],
            "default": "chat"
          },
          "input_modalities": {
            "type": "array",
            "description": "Content types this model accepts as input. Chat models default to text only; vision-language models add \"image\". Advertised on /v1/models and used to reject unsupported content.",
            "items": {
              "type": "string",
              "enum": ["text", "image", "audio"]
            },
            "uniqueItems": true,
            "default": ["text"]
          },
          "api_base": {
            "type": "string",
            "description": "Custom API endpoint URL"
          },
          "file_path": {
            "type": "string",
            "description": "Local model file path"
          },
          "api_key": {
            "type": "string",
            "description": "API key for this model"
          },
          "examples_as_sys_msg": {
            "type": "boolean",
            "description": "Whether to include examples as system messages",
            "default": false
          },
          "download": {
            "type": "object",
            "description": "Download metadata for single-file models",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "description": "Download URL"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "SHA256 checksum"
              },
              "cachePath": {
                "type": "string",
                "description": "Relative cache path"
              }
            },
            "required": ["url", "sha256"]
          },
          "compatibility": {
            "type": "object",
            "properties": {
              "minSchemaVersion": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "maxSchemaVersion": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "minClientVersion": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "maxClientVersion": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              }
            }
          },
          "context_window": {
            "type": "integer",
            "description": "Context window size in tokens",
            "minimum": 0
          },
          "default_context": {
            "type": "integer",
            "description": "Context size to allocate when a load request doesn't specify one. Without it, a load defaults to the largest context that fits available VRAM (capped by context_scaling.max_context), which can pin far more KV cache than a workload needs. An explicit context_size on the load request still overrides this, up to the hardware/model limit.",
            "minimum": 0
          },
          "max_tokens": {
            "type": "integer",
            "description": "Maximum tokens per completion",
            "minimum": 0
          },
          "max_input_tokens": {
            "type": "integer",
            "description": "Maximum input tokens",
            "minimum": 0
          },
          "max_output_tokens": {
            "type": "integer",
            "description": "Maximum output tokens",
            "minimum": 0
          },
          "pricing": {
            "type": "object",
            "description": "Pricing information. Token costs apply to chat/embedding models; the modality-specific costs apply to image/audio models.",
            "properties": {
              "prompt_token_cost": {
                "type": "number",
                "minimum": 0
              },
              "completion_token_cost": {
                "type": "number",
                "minimum": 0
              },
              "image_cost": {
                "type": "number",
                "description": "Cost per generated image (mode: image)",
                "minimum": 0
              },
              "audio_input_cost_per_second": {
                "type": "number",
                "description": "Cost per second of transcribed audio (mode: transcription)",
                "minimum": 0
              },
              "audio_output_cost_per_character": {
                "type": "number",
                "description": "Cost per character of synthesized speech (mode: speech)",
                "minimum": 0
              }
            }
          },
          "hardware_requirements": {
            "type": "object",
            "description": "Minimum hardware requirements for local models",
            "properties": {
              "min_system_ram_mb": {
                "type": "integer",
                "description": "Minimum system RAM in MB for CPU offload",
                "minimum": 0
              },
              "parameter_count": {
                "type": "string",
                "description": "Human-readable parameter count (e.g. 7B, 13B, 70B)"
              }
            }
          },
          "context_scaling": {
            "type": "object",
            "description": "Context size scaling based on available VRAM",
            "properties": {
              "base_context": {
                "type": "integer",
                "description": "Context size at minimum VRAM",
                "minimum": 0
              },
              "max_context": {
                "type": "integer",
                "description": "Maximum context the model supports",
                "minimum": 0
              },
              "vram_per_1k_context_mb": {
                "type": "integer",
                "description": "Additional VRAM in MB per 1K context tokens",
                "minimum": 0
              }
            }
          },
          "variants": {
            "type": "array",
            "description": "Quantization variants for local models",
            "items": {
              "type": "object",
              "required": ["quantization"],
              "properties": {
                "quantization": {
                  "type": "string",
                  "description": "Quantization format (e.g. Q4_K_M, Q8_0, F16)"
                },
                "file_size_mb": {
                  "type": "integer",
                  "description": "File size in MB",
                  "minimum": 0
                },
                "min_vram_mb": {
                  "type": "integer",
                  "description": "Minimum VRAM in MB to run this variant",
                  "minimum": 0
                },
                "recommended_vram_mb": {
                  "type": "integer",
                  "description": "Recommended VRAM in MB for good performance",
                  "minimum": 0
                },
                "download": {
                  "type": "object",
                  "description": "Download metadata for this variant (single file)",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "description": "Download URL"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$",
                      "description": "SHA256 checksum"
                    },
                    "filename": {
                      "type": "string",
                      "description": "Local filename for the downloaded model"
                    }
                  },
                  "required": ["url", "filename"]
                },
                "files": {
                  "type": "array",
                  "description": "Download metadata for split/multi-shard GGUF variants. When present, takes precedence over the single download field.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Download URL for this shard"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$",
                        "description": "SHA256 checksum for this shard"
                      },
                      "filename": {
                        "type": "string",
                        "description": "Local filename for this shard"
                      }
                    },
                    "required": ["url", "filename"]
                  },
                  "minItems": 1
                },
                "mmproj": {
                  "type": "object",
                  "description": "Multimodal projector (vision/audio encoder) GGUF paired with this variant. Downloaded alongside the model and loaded by libmtmd; required for models that declare \"image\" in input_modalities. When the projector is GPU-offloaded (runtime_options.mmproj_use_gpu, default true) its size should be included in min_vram_mb.",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "description": "Download URL"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$",
                      "description": "SHA256 checksum"
                    },
                    "filename": {
                      "type": "string",
                      "description": "Local filename for the downloaded projector"
                    },
                    "file_size_mb": {
                      "type": "integer",
                      "description": "Projector file size in MB",
                      "minimum": 0
                    }
                  },
                  "required": ["url", "filename"]
                }
              }
            }
          },
          "runtime_options": {
            "type": "object",
            "description": "Runtime options for llama.cpp model loading and inference. Applied as defaults; can be overridden at load time via the API.",
            "properties": {
              "flash_attn": {
                "type": "boolean",
                "description": "Enable or disable flash attention (-fa)"
              },
              "kv_cache_type_k": {
                "type": "string",
                "description": "KV cache data type for keys (-ctk)",
                "enum": ["f32", "f16", "bf16", "q8_0", "q4_0", "q4_1", "q5_0", "q5_1"]
              },
              "kv_cache_type_v": {
                "type": "string",
                "description": "KV cache data type for values (-ctv)",
                "enum": ["f32", "f16", "bf16", "q8_0", "q4_0", "q4_1", "q5_0", "q5_1"]
              },
              "no_mmap": {
                "type": "boolean",
                "description": "Disable memory-mapped file I/O (--no-mmap)"
              },
              "reasoning_budget": {
                "type": "integer",
                "description": "Reasoning token budget (--reasoning-budget). 0 disables reasoning tokens.",
                "minimum": 0
              },
              "swa_full": {
                "type": "boolean",
                "description": "Use full-size sliding window attention cache (--swa-full)"
              },
              "n_gpu_layers": {
                "type": "integer",
                "description": "Number of layers to offload to GPU (-ngl). 99 offloads all.",
                "minimum": 0
              },
              "override_tensor": {
                "type": "string",
                "description": "Tensor override pattern (-ot) for routing tensors to CPU/GPU"
              },
              "mmproj_use_gpu": {
                "type": "boolean",
                "description": "Offload the multimodal projector to the GPU (inverse of --no-mmproj-offload). Set false to run the vision encoder on CPU when the GPU backend is unstable for it."
              },
              "image_min_tokens": {
                "type": "integer",
                "description": "Minimum tokens an image expands to (--image-min-tokens). Vision models with dynamic resolution read a default from GGUF metadata; Qwen-VL needs at least 1024 for reliable grounding/OCR. Higher = more accurate and more expensive.",
                "minimum": 1
              },
              "image_max_tokens": {
                "type": "integer",
                "description": "Maximum tokens an image expands to (--image-max-tokens). Caps prompt cost for large images.",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "backend_priority": {
            "type": "array",
            "description": "Ordered preference for GPU backends. First available backend is used.",
            "items": {
              "type": "string",
              "enum": ["vulkan", "rocm", "cuda"]
            },
            "uniqueItems": true
          },
          "api_format": {
            "type": "string",
            "description": "Output format produced by the model. When set, the server converts the model's native output to standard OpenAI API format so clients don't need to understand it. 'harmony' = gpt-oss channel format; 'think_tags' = reasoning wrapped in <think>...</think> (Qwen3 Thinking, DeepSeek-R1 distills), split out into reasoning_content.",
            "enum": ["", "harmony", "think_tags"],
            "default": ""
          },
          "whisper_options": {
            "type": "object",
            "description": "Engine-specific defaults for the whisper (transcription) provider. Applied when the request omits the corresponding field.",
            "properties": {
              "language": {
                "type": "string",
                "description": "Default language hint (ISO-639-1, or 'auto' to detect)"
              },
              "translate": {
                "type": "boolean",
                "description": "Translate to English instead of transcribing in the source language"
              }
            },
            "additionalProperties": false
          },
          "sd_options": {
            "type": "object",
            "description": "Engine-specific defaults for the stable-diffusion (image) provider. Applied when the request omits the corresponding field.",
            "properties": {
              "steps": {
                "type": "integer",
                "description": "Default number of diffusion sample steps",
                "minimum": 1
              },
              "cfg_scale": {
                "type": "number",
                "description": "Default classifier-free guidance scale",
                "minimum": 0
              },
              "sampler": {
                "type": "string",
                "description": "Sampling method (e.g. euler_a, dpm++2m, dpm++2mv2)"
              },
              "width": {
                "type": "integer",
                "description": "Default image width in pixels",
                "minimum": 64
              },
              "height": {
                "type": "integer",
                "description": "Default image height in pixels",
                "minimum": 64
              },
              "vae_path": {
                "type": "string",
                "description": "Optional path to an external VAE file"
              }
            },
            "additionalProperties": false
          },
          "onnx_options": {
            "type": "object",
            "description": "ONNX Runtime GenAI settings (provider: onnx-genai). execution_providers selects the accelerator at runtime — omit it to use whatever the model's genai_config.json specifies.",
            "properties": {
              "execution_providers": {
                "type": "array",
                "description": "Ordered execution providers, e.g. [\"VitisAI\"] for the Ryzen AI NPU or [\"CPU\"].",
                "items": { "type": "string" }
              },
              "provider_options": {
                "type": "object",
                "description": "Per-provider key/value options, keyed by provider name."
              },
              "max_length": {
                "type": "integer",
                "description": "Hard cap on prompt + generated tokens.",
                "minimum": 1
              }
            }
          },
          "sherpa_options": {
            "type": "object",
            "description": "Model spec for the sherpa-onnx (transcription) provider. Selects a model family and its files; paths are resolved relative to file_path's directory when not absolute.",
            "properties": {
              "model_type": {
                "type": "string",
                "enum": ["whisper", "sense_voice", "paraformer", "nemo_ctc", "moonshine", "transducer"]
              },
              "tokens": { "type": "string", "description": "Path to tokens.txt" },
              "num_threads": { "type": "integer", "minimum": 1 },
              "feature_dim": { "type": "integer", "minimum": 1 },
              "decoding_method": { "type": "string" },
              "whisper": {
                "type": "object",
                "properties": {
                  "encoder": { "type": "string" },
                  "decoder": { "type": "string" },
                  "language": { "type": "string" },
                  "task": { "type": "string", "enum": ["transcribe", "translate"] },
                  "tail_paddings": { "type": "integer" }
                },
                "additionalProperties": false
              },
              "sense_voice": {
                "type": "object",
                "properties": {
                  "model": { "type": "string" },
                  "language": { "type": "string" },
                  "use_itn": { "type": "boolean" }
                },
                "additionalProperties": false
              },
              "paraformer": {
                "type": "object",
                "properties": { "model": { "type": "string" } },
                "additionalProperties": false
              },
              "nemo_ctc": {
                "type": "object",
                "properties": { "model": { "type": "string" } },
                "additionalProperties": false
              },
              "moonshine": {
                "type": "object",
                "properties": {
                  "preprocessor": { "type": "string" },
                  "encoder": { "type": "string" },
                  "uncached_decoder": { "type": "string" },
                  "cached_decoder": { "type": "string" }
                },
                "additionalProperties": false
              },
              "transducer": {
                "type": "object",
                "properties": {
                  "encoder": { "type": "string" },
                  "decoder": { "type": "string" },
                  "joiner": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "additionalProperties": false
}
